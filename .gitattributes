# Always Linux (LF) line endings, also when cloned on Windows with
# core.autocrlf=true (the Git for Windows default). CRLF breaks the shell
# script on Linux: "/usr/bin/env: 'bash\r': No such file or directory".
*           text=auto eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.example   text eol=lf
*.html      text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.md        text eol=lf
*.png       binary
